# Copy to .env and fill in. .env is gitignored — never commit real values.
# Resolve these with the project owner before Phase 0 (CLAUDE.md §2, §8 Q1).

# Named profile in ~/.aws/credentials, or leave blank to use the default chain.
AWS_PROFILE=
AWS_REGION=

# Source bucket holding the existing archive. READ-ONLY unless the project owner approves
# a write in writing (CLAUDE.md §9).
ARCHIVE_BUCKET=

# Optional prefix if the archive is one tree inside a shared bucket.
ARCHIVE_PREFIX=

# Set to 1 only after explicit approval. Every script that could mutate S3
# checks this and refuses by default.
ALLOW_S3_WRITES=0
